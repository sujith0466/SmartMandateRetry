# ==============================================================================
# SmartMandateRetry — Environment Configuration Template
# ==============================================================================

# Application Environment (development, staging, production, testing)
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=dev_secret_key_change_in_production_min_32_chars
PORT=5000

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=smartmandate_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartmandate_db

# Redis Configuration (Job Queue & Caching)
REDIS_URL=redis://localhost:6379/0

# Razorpay Integration (Test Mode by default)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=whsec_placeholder_webhook_secret

# AI Gateway Configuration (OpenRouter)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-placeholder_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_TIMEOUT_SECONDS=5.0
OPENROUTER_MAX_RETRIES=2

# Merchant Policy Defaults
POLICY_MAX_RETRIES=3
POLICY_MIN_INTERVAL_HOURS=24
POLICY_MAX_WINDOW_DAYS=14
POLICY_MIN_CONFIDENCE=0.75
POLICY_HIGH_VALUE_INR=10000.00
POLICY_MAX_CONTACTS=3
